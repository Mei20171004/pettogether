rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The request is a member of the household (has a member doc with their
    // auth uid as the doc id).
    function isMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    // The request is the household owner (household.ownerID matches).
    function isOwner(householdId) {
      return signedIn()
        && get(/databases/$(database)/documents/households/$(householdId)).data.ownerID == request.auth.uid;
    }

    // True after a transaction that atomically creates the household document
    // together with its first (owner) member doc.
    function isOwnerAfter(householdId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/households/$(householdId)).data.ownerID == request.auth.uid
        && getAfter(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.id == request.auth.uid
        && getAfter(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function validHousehold(data) {
      return data.name is string
        && data.name.size() > 0
        && data.pets is list
        && data.pets.size() > 0
        && data.pets.size() <= 20
        && (!('ownerID' in data) || data.ownerID is string)
        && (!('inviteCode' in data) || data.inviteCode is string);
    }

    function validMember(data, caregiverId) {
      return data.id == caregiverId
        && data.displayName is string
        && (data.role == 'owner' || data.role == 'caregiver');
    }

    function validInvitation(data) {
      return data.householdId is string
        && data.householdName is string
        && data.petNames is list
        && data.petNames.size() > 0
        && data.petNames.size() <= 20
        && data.invitedBy == request.auth.uid
        && data.inviterName is string
        && data.status == 'active'
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(24, 'h');
    }

    function validMedicationPlan(data) {
      return data.petId is string
        && data.petId.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.isActive is bool
        && data.revision is int;
    }

    function validHealthRecord(data) {
      return data.petId is string
        && data.petId.size() > 0
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.type is string
        && data.occurredAt is timestamp
        && (!('notes' in data) || data.notes == null
            || (data.notes is string && data.notes.size() <= 2000))
        && (!('attachments' in data) || data.attachments == null
            || (data.attachments is list && data.attachments.size() <= 10))
        && data.revision is int;
    }

    // The exact-link holder may claim an active invitation once; the same
    // transaction must create their pending join request.
    function validPendingJoin(data, caregiverId, householdId) {
      return signedIn()
        && caregiverId == request.auth.uid
        && data.keys().hasOnly([
          'userId', 'householdId', 'invitationId', 'name', 'email',
          'status', 'createdAt'
        ])
        && data.userId == request.auth.uid
        && data.householdId == householdId
        && data.name is string
        && data.invitationId is string
        && data.status == 'pending'
        && data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/invitations/$(data.invitationId)).data.householdId == householdId
        && getAfter(/databases/$(database)/documents/invitations/$(data.invitationId)).data.status == 'claimed'
        && getAfter(/databases/$(database)/documents/invitations/$(data.invitationId)).data.claimedBy == request.auth.uid;
    }

    // Session restore and pending-request restore use collection-group
    // queries; they must include the same uid filters required below.
    match /{path=**}/members/{caregiverId} {
      allow list: if signedIn() && resource.data.id == request.auth.uid;
    }

    match /{path=**}/joinRequests/{caregiverId} {
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Invitations (one-time 24h link/QR + owner approval)
    // ---------------------------------------------------------------------
    match /invitations/{invitationId} {
      // Invitations contain preview-only data. Exact lookup is allowed but
      // enumeration is blocked.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && isOwner(request.resource.data.householdId)
        && validInvitation(request.resource.data);

      // The exact-link holder may claim an active invitation once. The same
      // transaction must create their pending join request.
      allow update: if signedIn() &&
        ((resource.data.status == 'active' &&
          request.time < resource.data.expiresAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'claimedBy', 'claimedName', 'claimedAt'
          ]) &&
          request.resource.data.status == 'claimed' &&
          request.resource.data.claimedBy == request.auth.uid &&
          request.resource.data.claimedName is string &&
          request.resource.data.claimedAt == request.time &&
          getAfter(/databases/$(database)/documents/households/$(resource.data.householdId)/joinRequests/$(request.auth.uid)).data.invitationId == invitationId &&
          getAfter(/databases/$(database)/documents/households/$(resource.data.householdId)/joinRequests/$(request.auth.uid)).data.status == 'pending') ||
         // Owners can revoke an unused invitation…
         (isOwner(resource.data.householdId) &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'revoked' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'revokedAt'
          ]) &&
          request.resource.data.revokedAt == request.time) ||
         // …or close a claimed invitation as part of approving/rejecting it.
         (isOwner(resource.data.householdId) &&
          resource.data.status == 'claimed' &&
          (request.resource.data.status == 'approved' ||
           request.resource.data.status == 'rejected') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewedBy', 'reviewedAt'
          ]) &&
          request.resource.data.reviewedBy == request.auth.uid &&
          request.resource.data.reviewedAt == request.time));
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Households
    // ---------------------------------------------------------------------
    match /households/{householdId} {
      // Only the owner can create a new household; the first member doc is
      // created atomically in the same transaction.
      allow create: if signedIn()
        && validHousehold(request.resource.data)
        && request.resource.data.ownerID == request.auth.uid
        && isOwnerAfter(householdId);

      allow get: if isMember(householdId);
      allow list, delete: if false;
      // Members may update profile details; ownerID is immutable.
      allow update: if isMember(householdId)
        && validHousehold(request.resource.data)
        && ((!('ownerID' in request.resource.data) &&
             !('ownerID' in resource.data)) ||
            ('ownerID' in request.resource.data &&
             'ownerID' in resource.data &&
             request.resource.data.ownerID == resource.data.ownerID));

      match /members/{caregiverId} {
        allow get: if isMember(householdId) ||
            (signedIn() && caregiverId == request.auth.uid);
        allow list: if isMember(householdId) ||
            (signedIn() && resource.data.id == request.auth.uid);

        // New households create their owner atomically. All later members are
        // created by the owner only after an approved join request.
        allow create: if validMember(request.resource.data, caregiverId) &&
            ((signedIn() &&
              caregiverId == request.auth.uid &&
              request.resource.data.role == 'owner' &&
              isOwnerAfter(householdId)) ||
             (isOwner(householdId) &&
              request.resource.data.role == 'caregiver' &&
              getAfter(/databases/$(database)/documents/households/$(householdId)/joinRequests/$(caregiverId)).data.status == 'approved' &&
              getAfter(/databases/$(database)/documents/households/$(householdId)/joinRequests/$(caregiverId)).data.reviewedBy == request.auth.uid));

        // Members may edit their own display/notification settings, never
        // their identity or role.
        allow update: if signedIn() &&
            caregiverId == request.auth.uid &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'notificationsEnabled', 'notificationUpdatedAt',
              'updatedAt'
            ]);

        allow delete: if (signedIn() &&
            caregiverId == request.auth.uid &&
            resource.data.get('role', 'caregiver') != 'owner') ||
            (isOwner(householdId) &&
             caregiverId != request.auth.uid &&
             resource.data.get('role', 'caregiver') == 'caregiver');

        match /devices/{deviceId} {
          allow get, list, create, update, delete: if signedIn() &&
              caregiverId == request.auth.uid &&
              isMember(householdId);
        }
      }

      match /joinRequests/{caregiverId} {
        allow get: if (signedIn() && caregiverId == request.auth.uid) ||
            isOwner(householdId);
        allow list: if isOwner(householdId) ||
            (signedIn() && resource.data.userId == request.auth.uid);

        allow create: if validPendingJoin(
            request.resource.data, caregiverId, householdId);

        allow update: if isOwner(householdId) &&
            resource.data.status == 'pending' &&
            (request.resource.data.status == 'approved' ||
             request.resource.data.status == 'rejected') &&
            request.resource.data.reviewedBy == request.auth.uid &&
            request.resource.data.reviewedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reviewedBy', 'reviewedAt'
            ]);
        allow delete: if signedIn() &&
            caregiverId == request.auth.uid &&
            resource.data.status == 'pending';
      }

      match /routines/{routineId} {
        allow read: if isMember(householdId);
        allow create, update, delete: if isMember(householdId);
      }

      match /tasks/{taskId} {
        allow read: if isMember(householdId);
        allow create, update, delete: if isMember(householdId);
      }

      // -------------------------------------------------------------------
      // Health records
      //
      // Doses are not here: a dose is a task under /tasks, expanded from a
      // routine that carries the course's medicationPlanId. These collections
      // hold only the drug details and the medical history.
      // -------------------------------------------------------------------

      match /medicationPlans/{planId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && validMedicationPlan(request.resource.data);
        allow delete: if isMember(householdId);
      }

      match /healthRecords/{recordId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && validHealthRecord(request.resource.data);
        allow delete: if isMember(householdId);
      }
    }
  }
}
