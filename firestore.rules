rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 请求者是否是该家庭的成员（在 members 子集合里有自己的文档）。
    function isMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    // 请求者是否是家庭 owner（读取已提交状态）。
    function isOwner(householdId) {
      return signedIn()
        && get(/databases/$(database)/documents/households/$(householdId)).data.ownerID == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // 邀请码
    // ---------------------------------------------------------------------
    match /inviteCodes/{code} {
      // 已登录用户都可以读取，用来「加入家庭」时反查 householdID。
      allow read: if signedIn();

      // 只有该家庭 owner 才能生成邀请码（与创建家庭在同一事务里写入，
      // 所以用 getAfter 读取「事务提交后」的家庭 owner）。
      allow create: if signedIn()
        && request.resource.data.householdID is string
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdID)).data.ownerID == request.auth.uid;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // 家庭及其子集合
    // ---------------------------------------------------------------------
    match /households/{householdId} {
      // 只有 owner 能创建全新的家庭文档。
      allow create: if signedIn()
        && request.resource.data.ownerID == request.auth.uid;

      // 成员可读写；只有 owner 可删除。
      allow read, update: if isMember(householdId);
      allow delete: if isOwner(householdId);

      match /members/{memberId} {
        allow read: if isMember(householdId);

        // 加入家庭：只能添加「自己」，并且要么是 owner（创建家庭），
        // 要么携带一个有效且未失效的邀请码。
        allow create: if signedIn()
          && memberId == request.auth.uid
          && (
            getAfter(/databases/$(database)/documents/households/$(householdId)).data.ownerID == request.auth.uid
            || (
              request.resource.data.inviteCode is string
              && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode))
              && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.householdID == householdId
              && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.active == true
            )
          );

        // 只能改自己；删除自己（退出）或由 owner 删除成员。
        allow update: if signedIn() && memberId == request.auth.uid;
        allow delete: if signedIn()
          && (memberId == request.auth.uid || isOwner(householdId));
      }

      match /tasks/{taskId} {
        allow read, write: if isMember(householdId);
      }

      match /routines/{routineId} {
        allow read, write: if isMember(householdId);
      }
    }
  }
}
